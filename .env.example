# ─── Site ─────────────────────────────────────────────────────────────────────
# Canonical URL for this environment — no trailing slash
# localhost  → http://localhost:3000
# preview    → https://<branch>-recycling-hub.vercel.app  (set per deployment in Vercel)
# prod       → https://recyclinghub.eco
NEXT_PUBLIC_SITE_URL=https://recyclinghub.eco

# ─── API ──────────────────────────────────────────────────────────────────────
# Always the relative path "/api/v1" — the browser only ever calls this
# app's own origin. next.config.js rewrites it to API_PROXY_TARGET below
# (server-side, invisible to the browser). This is what makes the auth
# cookies same-origin instead of cross-origin — don't point this at an
# absolute URL.
NEXT_PUBLIC_API_URL=/api/v1

# The real Django backend this app proxies /api/v1/* to. Server-only — no
# NEXT_PUBLIC_ prefix, never sent to the browser.
# localhost → http://127.0.0.1:8001 (see recycling-hub-backend)
# prod      → https://api.recyclinghub.eco
API_PROXY_TARGET=http://127.0.0.1:8001

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Verifies the rh_access cookie's signature in src/middleware.ts (Edge
# runtime — must match the Django backend's JWT_SIGNING_KEY exactly, a
# dedicated secret decoupled from Django's own SECRET_KEY). Middleware only
# uses this for route-gating (UX) — the backend's own JWT verification via
# CookieJWTAuthentication remains the real authorization boundary.
JWT_VERIFY_SECRET=
